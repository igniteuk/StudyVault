{
  "name": "studyvault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first PWA for spaced flashcard review.",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-shell.mjs",
    "preview": "wrangler pages dev dist --ip 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "quality": "node scripts/quality.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
